{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Antigravity Proxy Tray",
  "version": "0.4.0",
  "identifier": "com.ltanedo.antigravityproxytray",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Antigravity Proxy Tray",
        "width": 480,
        "height": 360,
        "visible": false,
        "decorations": true,
        "resizable": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "signCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/sign-windows.ps1 %1"
    },
    "resources": {
      "../proxy-app/": "proxy-app/",
      "../bundled-runtime/": "bundled-runtime/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
